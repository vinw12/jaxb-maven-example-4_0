<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot 3.0 parent provides dependency management (Jakarta EE 10,
        JUnit 5, Jackson, etc.) and pre-configured build plugins.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.0.13</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>jaxb-maven-example</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>JAXB Maven Example</name>
    <description>
        Spring Boot 3.0 project demonstrating XSD-to-Java code generation via
        org.jvnet.jaxb:jaxb-maven-plugin with immutable-xjc and jaxb-annotate-plugin.
    </description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <jaxb.maven.plugin.version>4.0.12</jaxb.maven.plugin.version>
        <immutable.xjc.version>2.0.7</immutable.xjc.version>
        <!-- Override the version managed by Spring Boot BOM -->
        <jakarta.xml.bind.version>4.0.2</jakarta.xml.bind.version>
        <jaxb.impl.version>4.0.5</jaxb.impl.version>
    </properties>

    <dependencies>
        <!-- Spring Boot core: auto-configuration, logging, etc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
            Bean Validation (Hibernate Validator) – used at runtime to enforce
            the @NotNull constraints that jaxb-annotate-plugin injects into the
            generated Book fields.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Jakarta XML Binding API (JAXB 4.0) -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <version>${jakarta.xml.bind.version}</version>
        </dependency>

        <!-- JAXB reference implementation (runtime) -->
        <dependency>
            <groupId>com.sun.xml.bind</groupId>
            <artifactId>jaxb-impl</artifactId>
            <version>${jaxb.impl.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Boot test slice (includes JUnit 5 + AssertJ) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Spring Boot Maven Plugin – repackages the JAR as an executable
                Spring Boot fat-jar.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                JAXB Maven Plugin
                https://github.com/highsource/jaxb-tools/wiki/JAXB-Maven-Plugin

                Generates Java classes from the XML schema in src/main/resources.
                Two XJC extension plugins are added as dependencies:

                  1. immutable-xjc  – removes setters, marks fields/classes final,
                                      generates builder utility classes.
                  2. jaxb-annotate-plugin – reads annotation definitions embedded in
                                      the XSD (via the annox namespace) and adds them
                                      to the generated Java sources.
            -->
            <plugin>
                <groupId>org.jvnet.jaxb</groupId>
                <artifactId>jaxb-maven-plugin</artifactId>
                <version>${jaxb.maven.plugin.version}</version>
                <dependencies>
                    <!--
                        immutable-xjc
                        https://github.com/sabomichal/immutable-xjc
                    -->
                    <dependency>
                        <groupId>com.github.sabomichal</groupId>
                        <artifactId>immutable-xjc-plugin</artifactId>
                        <version>${immutable.xjc.version}</version>
                    </dependency>
                    <!--
                        JAXB Annotate Plugin
                        https://github.com/highsource/jaxb-tools/wiki/JAXB-Annotate-Home
                        Adds arbitrary Java annotations to generated classes by reading
                        annox:annotate customizations defined inline in the XSD.
                    -->
                    <dependency>
                        <groupId>org.jvnet.jaxb</groupId>
                        <artifactId>jaxb-plugin-annotate</artifactId>
                        <version>${jaxb.maven.plugin.version}</version>
                    </dependency>
                    <!--
                        Jakarta Bean Validation API is needed on the XJC classpath so
                        jaxb-plugin-annotate can resolve @NotNull and other constraint
                        annotation classes while generating sources.
                    -->
                    <dependency>
                        <groupId>jakarta.validation</groupId>
                        <artifactId>jakarta.validation-api</artifactId>
                        <version>3.0.2</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <!--
                                XSD files are picked up automatically from
                                src/main/resources (the plugin default).
                            -->
                            <extension>true</extension>
                            <args>
                                <!-- immutable-xjc: removes setters, marks fields/classes final -->
                                <arg>-Ximm</arg>
                                <!-- immutable-xjc: generate builder-pattern utility classes -->
                                <arg>-Ximm-builder</arg>
                                <!-- immutable-xjc: use Foo.builder()/Foo.Builder naming -->
                                <arg>-Ximm-simplebuildername</arg>
                                <!--
                                    jaxb-annotate-plugin: reads annox:annotate elements
                                    from the XSD and adds the specified Java annotations
                                    to the generated sources.
                                -->
                                <arg>-Xannotate</arg>
                            </args>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
